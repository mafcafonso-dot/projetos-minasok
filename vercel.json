{
  "rewrites": [
    {
      "source": "/",
      "destination": "/amortiza/app/index.html"
    },
    {
      "source": "/apresentacao",
      "destination": "/amortiza/apresentacao/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
